# ==============================================================================
# CodeForge Production & Local Environment Configuration
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=production

# PostgreSQL Database Connection URL (Must use a dedicated non-superuser role in production)
DATABASE_URL=postgresql://codeforge:secret_password@localhost:5432/codeforge?sslmode=disable

# Root Data Directory for Workspaces & Artifact Storage
# Defaults to OS temp folder if unset; in production set to a dedicated volume mount (e.g. /var/lib/codeforge)
CODEFORGE_DATA_DIR=./data

# Worker Configuration
CODEFORGE_WORKER_CONCURRENCY=2
CODEFORGE_WORKER_POLL_INTERVAL_MS=1000
CODEFORGE_MAX_JOB_ATTEMPTS=2
CODEFORGE_STALE_JOB_THRESHOLD_MS=180000

# Sandbox Security & Resource Limits
CODEFORGE_CPU_SECONDS=15
CODEFORGE_WALL_TIMEOUT_MS=20000
CODEFORGE_MAX_PROCESSES=64
CODEFORGE_MAX_VMEM_KB=1536000
CODEFORGE_MAX_UPLOAD_BYTES=2097152
CODEFORGE_MAX_PROJECT_UPLOAD_BYTES=10485760
CODEFORGE_MAX_PROJECT_EXTRACTED_BYTES=26214400
CODEFORGE_MAX_PROJECT_FILE_COUNT=100
CODEFORGE_MAX_ARTIFACT_BYTES=52428800

# Artifact Lifecycle (TTL in milliseconds; 30 minutes default)
CODEFORGE_ARTIFACT_TTL_MS=1800000

# Rate Limiting
CODEFORGE_RATE_LIMIT_WINDOW_MS=300000
CODEFORGE_RATE_LIMIT_MAX_BUILDS=10

# API / CLI Service Base URL
CODEFORGE_API_URL=http://localhost:3000
