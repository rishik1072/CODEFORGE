# CodeForge External Build Worker Environment Configuration
# ==============================================================================
# Deploy this file on your Docker-capable Linux server (e.g. Ubuntu 22.04 LTS)
# running Docker Engine and Node.js 20+.
# ==============================================================================

NODE_ENV=production

# PostgreSQL Database Connection (Must point to the same database as Vercel)
# e.g. Neon, Supabase, AWS RDS, or managed Postgres instance with SSL
DATABASE_URL=postgresql://codeforge_user:secret_password@managed-db.provider.com:5432/codeforge?sslmode=require

# Worker Concurrency & Polling
# 2-4 recommended per worker process depending on host CPU and RAM
CODEFORGE_WORKER_CONCURRENCY=2
CODEFORGE_WORKER_POLL_INTERVAL_MS=1000
CODEFORGE_MAX_JOB_ATTEMPTS=2
CODEFORGE_STALE_JOB_THRESHOLD_MS=180000

# Sandbox Security & Resource Limits
CODEFORGE_CPU_SECONDS=15
CODEFORGE_WALL_TIMEOUT_MS=20000
CODEFORGE_MAX_PROCESSES=64
CODEFORGE_MAX_VMEM_KB=1536000
CODEFORGE_MAX_UPLOAD_BYTES=2097152
CODEFORGE_MAX_PROJECT_UPLOAD_BYTES=10485760
CODEFORGE_MAX_PROJECT_EXTRACTED_BYTES=26214400
CODEFORGE_MAX_PROJECT_FILE_COUNT=100
CODEFORGE_MAX_ARTIFACT_BYTES=52428800

# Artifact Retention (TTL in ms; 30 minutes default)
CODEFORGE_ARTIFACT_TTL_MS=1800000

# Worker Storage Root
CODEFORGE_DATA_DIR=/var/lib/codeforge
